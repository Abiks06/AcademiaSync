# Supabase project settings (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Public URL of the app, used in sign-in links. Optional locally; set it in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Live editing (https://liveblocks.io/dashboard/apikeys). Server-side only: never expose this to the browser.
LIVEBLOCKS_SECRET_KEY="sk_..."
# To work offline, run the app inside the local Liveblocks dev server instead:
#   npx liveblocks dev -c "npm run dev"
# It sets LIVEBLOCKS_BASE_URL, NEXT_PUBLIC_LIVEBLOCKS_BASE_URL and a local secret key for you.

# Server-side saving (Supabase → Project Settings → API keys → Secret key). Server only.
# The server uses it to copy the live manuscript into Supabase and to write version history.
SUPABASE_SECRET_KEY="sb_secret_..."

# Liveblocks → Webhooks: add https://<your-domain>/api/liveblocks-webhook with the
# "ydocUpdated" event, then paste its signing secret here.
LIVEBLOCKS_WEBHOOK_SECRET="whsec_..."

# Invite emails through Resend (https://resend.com). Without these, invites still work:
# the inviter gets a link to send themselves. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY="re_..."
EMAIL_FROM="AcademiaSync <invites@your-domain.edu>"
